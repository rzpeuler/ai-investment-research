{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-os.local/schemas/chat_daily_review_input.schema.json",
  "title": "ChatDailyReviewInput",
  "description": "每日复盘会话中由用户表达的语义。",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity_mentions", "industry_mentions", "temporal_expression", "research_focus", "complete", "clarification_question"],
  "properties": {
    "entity_mentions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "industry_mentions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "temporal_expression": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "research_focus": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "complete": {"type": "boolean"},
    "clarification_question": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
  }
}
