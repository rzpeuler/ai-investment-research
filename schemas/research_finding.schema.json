{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-os.local/schemas/research_finding.schema.json",
  "title": "ResearchFinding",
  "description": "研究发现（Phase 4 任务书 3.9.3-17）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id", "request_id", "company_entity_id", "finding_type", "title",
    "statement", "claim_type", "predicate", "object", "as_of", "evidence_ids",
    "supporting_object_ids", "counter_evidence_ids", "confidence", "support_level",
    "status", "invalidation_conditions", "materiality", "section_id",
    "model_route", "version", "created_at"
  ],
  "properties": {
    "finding_id": { "type": "string" },
    "request_id": { "type": "string" },
    "company_entity_id": { "type": "string", "pattern": "^company:" },
    "finding_type": { "type": "string", "enum": ["fact_summary", "business_analysis", "financial_quality", "industry_position", "peer_comparison", "valuation_observation", "governance", "controversy", "research_question", "conclusion"] },
    "title": { "type": "string", "minLength": 1 },
    "statement": { "type": "string", "minLength": 1 },
    "claim_type": { "type": "string", "enum": ["FACT", "SOURCE_OPINION", "MODEL_INFERENCE", "HYPOTHESIS", "UNKNOWN", "CONFLICT"] },
    "predicate": { "type": "string" },
    "object": { "type": "object" },
    "as_of": { "type": "string", "format": "date-time" },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "supporting_object_ids": { "type": "array", "items": { "type": "string" } },
    "counter_evidence_ids": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "support_level": { "type": "string", "enum": ["direct", "indirect", "inferred"] },
    "status": { "type": "string", "enum": ["supported", "contested", "unknown"] },
    "invalidation_conditions": { "type": "array", "items": { "type": "string" } },
    "materiality": { "type": "string", "enum": ["high", "medium", "low"] },
    "section_id": { "type": "string" },
    "model_route": { "anyOf": [ { "type": "object" }, { "type": "null" } ] },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
