{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-os.local/schemas/industry_research_run.schema.json",
  "title": "IndustryResearchRun",
  "description": "行业研究运行记录（Phase 6A）",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "request_id", "task_id", "idempotency_key", "run_version", "started_at", "finished_at", "status", "stage_statuses", "artifact_paths", "input_versions", "model_route_summary", "validation_status", "error_codes", "version"],
  "properties": {
    "run_id": {"type": "string"},
    "request_id": {"type": "string"},
    "task_id": {"type": "string"},
    "industry_id": {"type": "string"},
    "industry_name": {"type": "string"},
    "as_of": {"type": "string", "format": "date-time"},
    "depth": {"type": "string", "enum": ["fast", "standard", "deep"]},
    "status": {"type": "string", "enum": ["success", "partial_success", "degraded", "insufficient_evidence", "failed"]},
    "idempotency_key": {"type": "string"},
    "run_version": {"type": "integer", "minimum": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "stage_statuses": {"type": "array"},
    "artifact_paths": {"type": "array"},
    "input_versions": {"type": "object"},
    "model_route_summary": {"type": "object"},
    "validation_status": {"type": "string"},
    "error_codes": {"type": "array"},
    "warnings": {"type": "array"},
    "missing_data": {"type": "array"},
    "findings_count": {"type": "integer"},
    "dimensions_covered": {"type": "array"},
    "dimensions_missing": {"type": "array"},
    "evidence_quality": {"type": "object"},
    "model_route": {"type": "object"},
    "data_degraded": {"type": "boolean"},
    "version": {"type": "integer", "minimum": 1}
  }
}
