{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-os.local/schemas/financial_metric.schema.json",
  "title": "FinancialMetric",
  "description": "确定性派生财务指标（Phase 4 任务书 3.9.3-8）。值使用十进制定点字符串；公式必须可复算。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metric_id", "company_entity_id", "metric_code", "period_end", "period_basis",
    "value", "unit", "status", "formula_id", "formula_version", "input_fact_ids", "input_bindings",
    "input_metric_ids", "precision", "sector_applicability", "quality_warnings",
    "evidence_ids", "calculated_at", "version"
  ],
  "properties": {
    "metric_id": { "type": "string" },
    "company_entity_id": { "type": "string", "pattern": "^company:" },
    "metric_code": { "type": "string", "minLength": 1 },
    "period_end": { "type": "string", "format": "date" },
    "period_basis": { "type": "string", "enum": ["annual", "interim", "single_quarter", "ttm", "point_in_time"] },
    "value": { "anyOf": [ { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" }, { "type": "null" } ] },
    "unit": { "type": "string" },
    "status": { "type": "string", "enum": ["valid", "missing", "not_applicable", "zero_denominator", "conflict", "insufficient_sample"] },
    "formula_id": { "type": "string", "minLength": 1 },
    "formula_version": { "type": "string", "minLength": 1 },
    "input_fact_ids": { "type": "array", "items": { "type": "string" } },
    "input_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parameter", "fact_id", "taxonomy_code", "period_end", "period_role"],
        "properties": {
          "parameter": { "type": "string", "minLength": 1 },
          "fact_id": { "type": "string", "minLength": 1 },
          "taxonomy_code": { "type": "string", "minLength": 1 },
          "period_end": { "type": "string", "format": "date" },
          "period_role": { "type": "string", "enum": ["current", "start", "end", "comparable"] }
        }
      }
    },
    "input_metric_ids": { "type": "array", "items": { "type": "string" } },
    "precision": { "type": "integer", "minimum": 0 },
    "sector_applicability": { "type": "string", "enum": ["general", "non_financial", "financial", "cyclical"] },
    "quality_warnings": { "type": "array", "items": { "type": "string" } },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "calculated_at": { "type": "string", "format": "date-time" },
    "version": { "type": "integer", "minimum": 1 }
  }
}
