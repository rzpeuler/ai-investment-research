{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-os.local/schemas/peer_candidate.schema.json",
  "title": "PeerCandidate",
  "description": "冻结同行宇宙中的一个候选及其评分（Phase 4 任务书 3.9.3-10）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "peer_candidate_id", "subject_company_id", "candidate_company_id",
    "information_cutoff", "universe_version", "relationship_valid_from",
    "relationship_valid_to", "industry_score", "business_model_score",
    "revenue_mix_score", "supply_chain_score", "size_score", "listing_tenure_score",
    "accounting_comparability_score", "region_score", "data_completeness_score",
    "core_subtotal", "total_score", "eligible", "exclusion_reasons",
    "llm_assisted_dimensions", "evidence_ids", "warnings", "version", "created_at"
  ],
  "properties": {
    "peer_candidate_id": { "type": "string" },
    "subject_company_id": { "type": "string", "pattern": "^company:" },
    "candidate_company_id": { "type": "string", "pattern": "^company:" },
    "information_cutoff": { "type": "string", "format": "date-time" },
    "universe_version": { "type": "string", "minLength": 1 },
    "relationship_valid_from": { "type": "string", "format": "date" },
    "relationship_valid_to": { "anyOf": [ { "type": "string", "format": "date" }, { "type": "null" } ] },
    "industry_score": { "type": "integer", "minimum": 0, "maximum": 5 },
    "business_model_score": { "type": "integer", "minimum": 0, "maximum": 5 },
    "revenue_mix_score": { "type": "integer", "minimum": 0, "maximum": 5 },
    "supply_chain_score": { "type": "integer", "minimum": 0, "maximum": 5 },
    "size_score": { "type": "integer", "minimum": 0, "maximum": 5 },
    "listing_tenure_score": { "type": "integer", "minimum": 0, "maximum": 5 },
    "accounting_comparability_score": { "type": "integer", "minimum": 0, "maximum": 5 },
    "region_score": { "type": "integer", "minimum": 0, "maximum": 5 },
    "data_completeness_score": { "type": "integer", "minimum": 0, "maximum": 5 },
    "core_subtotal": { "type": "number", "minimum": 0, "maximum": 100 },
    "total_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "eligible": { "type": "boolean" },
    "exclusion_reasons": { "type": "array", "items": { "type": "string" } },
    "llm_assisted_dimensions": { "type": "array", "items": { "type": "string" } },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
