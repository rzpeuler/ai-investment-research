{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-os.local/schemas/financial_evidence_binding_manifest.schema.json",
  "title": "FinancialEvidenceBindingManifest",
  "description": "官方原件到财务事实的人工复核定位输入。",
  "type": "object",
  "additionalProperties": false,
  "required": ["binding_version", "company_entity_id", "as_of", "locators"],
  "properties": {
    "binding_version": {"type": "string", "minLength": 1},
    "company_entity_id": {"type": "string", "pattern": "^company:"},
    "as_of": {"type": "string", "format": "date-time"},
    "locators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taxonomy_code", "period_end", "statement_scope", "document_id",
          "document_evidence_id", "locator_kind", "page_start", "page_end",
          "section_path", "table_id", "row_index", "column_index",
          "cell_reference", "text_start", "text_end", "structured_field",
          "source_excerpt", "reported_raw_value", "currency", "unit_scale",
          "confirmation_status", "confirmed_by", "confirmed_at", "correction_reason"
        ],
        "properties": {
          "taxonomy_code": {"type": "string", "minLength": 1},
          "period_end": {"type": "string", "format": "date"},
          "statement_scope": {"type": "string", "enum": ["consolidated", "parent"]},
          "document_id": {"type": "string", "minLength": 1},
          "document_evidence_id": {"type": "string", "minLength": 1},
          "locator_kind": {"type": "string", "enum": ["page", "table", "row", "column", "cell", "section", "text_offset", "structured_field"]},
          "page_start": {"type": "integer", "minimum": 1},
          "page_end": {"type": "integer", "minimum": 1},
          "section_path": {"type": "array", "items": {"type": "string"}},
          "table_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "row_index": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
          "column_index": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
          "cell_reference": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "text_start": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
          "text_end": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
          "structured_field": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "source_excerpt": {"type": "string", "minLength": 1},
          "reported_raw_value": {"type": "string", "pattern": "^-?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$"},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "unit_scale": {"type": "integer", "exclusiveMinimum": 0},
          "confirmation_status": {"type": "string", "enum": ["confirmed", "corrected"]},
          "confirmed_by": {"type": "string", "minLength": 1},
          "confirmed_at": {"type": "string", "format": "date-time"},
          "correction_reason": {"anyOf": [{"type": "string"}, {"type": "null"}]}
        }
      }
    }
  }
}
