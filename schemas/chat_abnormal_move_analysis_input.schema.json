{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-os.local/schemas/chat_abnormal_move_analysis_input.schema.json",
  "title": "ChatAbnormalMoveAnalysisInput",
  "description": "异动分析会话中由用户表达的语义。",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity_mentions", "temporal_expression", "research_question", "metric_expressions", "complete", "clarification_question"],
  "properties": {
    "entity_mentions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "temporal_expression": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "research_question": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "metric_expressions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "complete": {"type": "boolean"},
    "clarification_question": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
  }
}
