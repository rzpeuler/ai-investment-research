{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-os.local/schemas/financial_fact.schema.json",
  "title": "FinancialFact",
  "description": "一个标准科目在确定期间和口径下的值（Phase 4 任务书 3.9.3-7）。财务值使用十进制定点字符串。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fact_id", "fact_key", "financial_report_id", "company_entity_id",
    "statement_type", "taxonomy_code", "label_raw", "period_start", "period_end",
    "instant_or_duration", "period_basis", "statement_scope", "currency",
    "unit_scale", "raw_value", "normalized_value", "normalized_unit",
    "value_status", "sign_convention", "audit_status", "segment_id",
    "source_document_id", "source_block_ids", "evidence_ids", "source_priority",
    "restatement_version", "valid_from", "valid_to", "conflict_group_id",
    "warnings", "version", "created_at"
  ],
  "properties": {
    "fact_id": { "type": "string" },
    "fact_key": { "type": "string", "minLength": 1 },
    "financial_report_id": { "type": "string" },
    "company_entity_id": { "type": "string", "pattern": "^company:" },
    "statement_type": { "type": "string", "enum": ["income_statement", "balance_sheet", "cash_flow", "equity_statement", "note", "operating_data"] },
    "taxonomy_code": { "type": "string", "minLength": 1 },
    "label_raw": { "type": "string" },
    "period_start": { "anyOf": [ { "type": "string", "format": "date" }, { "type": "null" } ] },
    "period_end": { "type": "string", "format": "date" },
    "instant_or_duration": { "type": "string", "enum": ["instant", "duration"] },
    "period_basis": { "type": "string", "enum": ["reported_period", "ytd", "single_quarter", "ttm"] },
    "statement_scope": { "type": "string", "enum": ["consolidated", "parent"] },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "unit_scale": { "type": "integer" },
    "raw_value": { "anyOf": [ { "type": "string", "pattern": "^-?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$" }, { "type": "null" } ] },
    "normalized_value": { "anyOf": [ { "type": "string", "pattern": "^-?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$" }, { "type": "null" } ] },
    "normalized_unit": { "type": "string" },
    "value_status": { "type": "string", "enum": ["reported", "derived_from_report", "missing", "not_applicable", "conflict"] },
    "sign_convention": { "type": "string", "enum": ["reported", "debit_positive", "credit_positive"] },
    "audit_status": { "type": "string", "enum": ["audited", "reviewed", "unaudited", "unknown"] },
    "segment_id": { "anyOf": [ { "type": "string" }, { "type": "null" } ] },
    "source_document_id": { "anyOf": [ { "type": "string" }, { "type": "null" } ] },
    "source_block_ids": { "type": "array", "items": { "type": "string" } },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "source_priority": { "type": "integer", "minimum": 1, "maximum": 6 },
    "restatement_version": { "type": "integer", "minimum": 1 },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_to": { "anyOf": [ { "type": "string", "format": "date-time" }, { "type": "null" } ] },
    "conflict_group_id": { "anyOf": [ { "type": "string" }, { "type": "null" } ] },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
