{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-os.local/schemas/chat_industry_research_input.schema.json",
  "title": "ChatIndustryResearchInput",
  "description": "行业研究会话中由用户表达的语义。",
  "type": "object",
  "additionalProperties": false,
  "required": ["industry_mentions", "company_mentions", "temporal_expression", "research_question", "research_focus", "depth_hint", "complete", "clarification_question"],
  "properties": {
    "industry_mentions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "company_mentions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "temporal_expression": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "research_question": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "research_focus": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "depth_hint": {"enum": [null, "fast", "standard", "deep"]},
    "complete": {"type": "boolean"},
    "clarification_question": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
  }
}
