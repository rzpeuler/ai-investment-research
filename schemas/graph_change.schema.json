{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-os.local/schemas/graph_change.schema.json",
  "title": "GraphChange",
  "description": "产业图谱变更候选（M1 正式化）。node 和 edge 使用 $ref 引用 GraphNode/GraphEdge。依据工程指南 46 节和 Phase 5 正式任务书。未审核不得进入核心图谱。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graph_change_id",
    "change_type",
    "node",
    "edge",
    "current_knowledge",
    "new_evidence_ids",
    "suggested_change",
    "impact_scope",
    "conflicts",
    "verification_points",
    "review_status",
    "created_at",
    "reviewed_at"
  ],
  "properties": {
    "graph_change_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$",
      "description": "UUID"
    },
    "change_type": {
      "type": "string",
      "enum": ["add_node", "add_edge", "modify_attribute", "retire_edge", "retire_node"],
      "description": "变更类型"
    },
    "node": {
      "anyOf": [
        { "$ref": "graph_node.schema.json" },
        { "type": "null" }
      ],
      "description": "变更涉及的图谱节点。add_node / retire_node 时非 null。candidate payload 时 origin_kind=graph_change, review_status=candidate。"
    },
    "edge": {
      "anyOf": [
        { "$ref": "graph_edge.schema.json" },
        { "type": "null" }
      ],
      "description": "变更涉及的图谱关系。add_edge / retire_edge 时非 null。candidate payload 时 assertion_type != GOVERNANCE, review_status=candidate。"
    },
    "current_knowledge": {
      "type": "string",
      "description": "当前知识"
    },
    "new_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" },
      "description": "新证据 ID。GraphChange 不承担 governance seed。"
    },
    "suggested_change": {
      "type": "string",
      "minLength": 1,
      "description": "建议变更"
    },
    "impact_scope": {
      "type": "array",
      "items": { "type": "string" },
      "description": "影响范围"
    },
    "conflicts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "冲突信息"
    },
    "verification_points": {
      "type": "array",
      "items": { "type": "string" },
      "description": "验证节点"
    },
    "review_status": {
      "type": "string",
      "enum": ["candidate", "approved", "approved_with_changes", "deferred", "rejected"],
      "description": "审核状态。candidate 时 reviewed_at 须为 null；其他状态 reviewed_at 须非 null。"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "创建时间"
    },
    "reviewed_at": {
      "anyOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ],
      "description": "审核时间"
    }
  }
}
