{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-os.local/schemas/graph_change.schema.json",
  "title": "GraphChange",
  "description": "产业图谱变更候选（M1-R3：$ref 复用 GraphNode/GraphEdge，allOf 叠加 candidate 约束）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graph_change_id", "change_type", "node", "edge", "current_knowledge",
    "new_evidence_ids", "suggested_change", "impact_scope", "conflicts",
    "verification_points", "review_status", "created_at", "reviewed_at"
  ],
  "properties": {
    "graph_change_id": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
    "change_type": { "type": "string", "enum": ["add_node","add_edge","modify_attribute","retire_edge","retire_node"] },
    "node": {
      "anyOf": [
        {
          "allOf": [
            { "$ref": "https://research-os.local/schemas/graph_node.schema.json" },
            {
              "type": "object",
              "properties": {
                "origin_kind": { "const": "graph_change" },
                "review_status": { "const": "candidate" },
                "last_reviewed_at": { "type": "null" }
              }
            }
          ]
        },
        { "type": "null" }
      ]
    },
    "edge": {
      "anyOf": [
        {
          "allOf": [
            { "$ref": "https://research-os.local/schemas/graph_edge.schema.json" },
            {
              "type": "object",
              "properties": {
                "assertion_type": { "enum": ["FACT","MODEL_INFERENCE"] },
                "review_status": { "const": "candidate" },
                "last_reviewed_at": { "type": "null" }
              }
            }
          ]
        },
        { "type": "null" }
      ]
    },
    "current_knowledge": { "type": "string" },
    "new_evidence_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "suggested_change": { "type": "string", "minLength": 1 },
    "impact_scope": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": "array", "items": { "type": "string" } },
    "verification_points": { "type": "array", "items": { "type": "string" } },
    "review_status": { "type": "string", "enum": ["candidate","approved","approved_with_changes","deferred","rejected"] },
    "created_at": { "type": "string", "format": "date-time" },
    "reviewed_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] }
  },
  "allOf": [
    {
      "if": { "properties": { "review_status": { "const": "candidate" } }, "required": ["review_status"] },
      "then": { "properties": { "reviewed_at": { "type": "null" } } }
    },
    {
      "if": { "properties": { "review_status": { "enum": ["approved","approved_with_changes","deferred","rejected"] } }, "required": ["review_status"] },
      "then": { "properties": { "reviewed_at": { "type": "string", "format": "date-time" } } }
    },
    {
      "if": { "properties": { "change_type": { "enum": ["add_node","retire_node"] } }, "required": ["change_type"] },
      "then": { "properties": { "node": { "type": "object" }, "edge": { "type": "null" } } }
    },
    {
      "if": { "properties": { "change_type": { "enum": ["add_edge","retire_edge"] } }, "required": ["change_type"] },
      "then": { "properties": { "node": { "type": "null" }, "edge": { "type": "object" } } }
    },
    {
      "if": { "properties": { "change_type": { "const": "modify_attribute" } }, "required": ["change_type"] },
      "then": {
        "anyOf": [
          { "properties": { "node": { "type": "object" }, "edge": { "type": "null" } } },
          { "properties": { "node": { "type": "null" }, "edge": { "type": "object" } } }
        ]
      }
    }
  ]
}
