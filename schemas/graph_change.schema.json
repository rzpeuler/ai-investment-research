{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-os.local/schemas/graph_change.schema.json",
  "title": "GraphChange",
  "description": "产业图谱变更候选（M1 正式化）。node/edge 与 GraphNode/GraphEdge 结构一致，不再使用 $ref。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graph_change_id", "change_type", "node", "edge", "current_knowledge",
    "new_evidence_ids", "suggested_change", "impact_scope", "conflicts",
    "verification_points", "review_status", "created_at", "reviewed_at"
  ],
  "properties": {
    "graph_change_id": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
    "change_type": { "type": "string", "enum": ["add_node","add_edge","modify_attribute","retire_edge","retire_node"] },
    "node": {
      "anyOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["node_id","node_type","name","aliases","description","status","valid_from","valid_to","evidence_ids","version","last_reviewed_at","review_status","origin_kind","originating_graph_change_id","created_at"],
          "properties": {
            "node_id": { "type": "string", "minLength": 1 },
            "node_type": { "type": "string", "enum": ["Industry","IndustrySegment","Company","Product","Technology","Material","Equipment","Application","Policy","Event","Metric","PersonOrInstitution","Report","InvestmentTheme"] },
            "name": { "type": "string", "minLength": 1 },
            "aliases": { "type": "array", "items": { "type": "string" } },
            "description": { "type": "string" },
            "status": { "type": "string", "enum": ["active","superseded","expired","retired"] },
            "valid_from": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
            "valid_to": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
            "evidence_ids": { "type": "array", "items": { "type": "string" } },
            "version": { "type": "integer", "minimum": 1 },
            "last_reviewed_at": { "type": "null" },
            "review_status": { "const": "candidate" },
            "origin_kind": { "const": "graph_change" },
            "originating_graph_change_id": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
            "created_at": { "type": "string", "format": "date-time" }
          }
        },
        { "type": "null" }
      ]
    },
    "edge": {
      "anyOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["edge_id","source_node_id","relation","target_node_id","attributes","assertion_type","valid_from","valid_to","confidence","evidence_ids","review_status","version","originating_graph_change_id","created_at","last_reviewed_at"],
          "properties": {
            "edge_id": { "type": "string", "minLength": 1 },
            "source_node_id": { "type": "string", "minLength": 1 },
            "relation": { "type": "string", "enum": ["BELONGS_TO","UPSTREAM_OF","DOWNSTREAM_OF","SUPPLIES","PURCHASES_FROM","PRODUCES","USES_TECHNOLOGY","APPLIED_IN","COMPETES_WITH","SUBSTITUTES","BENEFITS_FROM","HARMED_BY","AFFECTS","MENTIONED_IN","SUPPORTED_BY","CONTRADICTED_BY","HAS_METRIC","HAS_CATALYST"] },
            "target_node_id": { "type": "string", "minLength": 1 },
            "attributes": { "type": "object" },
            "assertion_type": { "type": "string", "enum": ["FACT","MODEL_INFERENCE"] },
            "valid_from": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
            "valid_to": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
            "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "review_status": { "const": "candidate" },
            "version": { "type": "integer", "minimum": 1 },
            "originating_graph_change_id": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
            "created_at": { "type": "string", "format": "date-time" },
            "last_reviewed_at": { "type": "null" }
          }
        },
        { "type": "null" }
      ]
    },
    "current_knowledge": { "type": "string" },
    "new_evidence_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "suggested_change": { "type": "string", "minLength": 1 },
    "impact_scope": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": "array", "items": { "type": "string" } },
    "verification_points": { "type": "array", "items": { "type": "string" } },
    "review_status": { "type": "string", "enum": ["candidate","approved","approved_with_changes","deferred","rejected"] },
    "created_at": { "type": "string", "format": "date-time" },
    "reviewed_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "review_status": { "const": "candidate" } },
        "required": ["review_status"]
      },
      "then": { "properties": { "reviewed_at": { "type": "null" } } }
    },
    {
      "if": {
        "properties": { "review_status": { "enum": ["approved","approved_with_changes","deferred","rejected"] } },
        "required": ["review_status"]
      },
      "then": { "properties": { "reviewed_at": { "type": "string", "format": "date-time" } } }
    },
    {
      "if": {
        "properties": { "change_type": { "enum": ["add_node","retire_node"] } },
        "required": ["change_type"]
      },
      "then": {
        "properties": { "node": { "type": "object" }, "edge": { "type": "null" } }
      }
    },
    {
      "if": {
        "properties": { "change_type": { "enum": ["add_edge","retire_edge"] } },
        "required": ["change_type"]
      },
      "then": {
        "properties": { "node": { "type": "null" }, "edge": { "type": "object" } }
      }
    },
    {
      "if": {
        "properties": { "change_type": { "const": "modify_attribute" } },
        "required": ["change_type"]
      },
      "then": {
        "anyOf": [
          { "properties": { "node": { "type": "object" }, "edge": { "type": "null" } } },
          { "properties": { "node": { "type": "null" }, "edge": { "type": "object" } } }
        ]
      }
    }
  ]
}
