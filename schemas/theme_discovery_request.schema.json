{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-os.local/schemas/theme_discovery_request.schema.json",
  "title": "ThemeDiscoveryRequest",
  "description": "主题发现请求（Phase 6A）",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "task_id", "theme_triggers", "as_of", "as_of_basis", "timezone", "depth", "discovery_mode", "live", "dry_run", "force", "source_policy", "status", "warnings", "rule_versions", "requested_at", "version"],
  "properties": {
    "request_id": {"type": "string"},
    "task_id": {"type": "string"},
    "theme_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trigger_type", "description"],
        "properties": {
          "trigger_type": {"type": "string"},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "as_of": {"type": "string", "format": "date-time"},
    "as_of_basis": {"type": "string"},
    "timezone": {"type": "string"},
    "depth": {"type": "string", "enum": ["fast", "standard", "deep"]},
    "discovery_mode": {"type": "string", "enum": ["graph_based", "evidence_driven", "keyword_sweep", "peer_diffusion"]},
    "industry_ids": {"type": "array", "items": {"type": "string"}},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "live": {"type": "boolean"},
    "dry_run": {"type": "boolean"},
    "force": {"type": "boolean"},
    "source_policy": {"type": "string"},
    "status": {"type": "string"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "rule_versions": {"type": "object"},
    "requested_at": {"type": "string", "format": "date-time"},
    "version": {"type": "integer", "minimum": 1}
  }
}
