{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-os.local/schemas/equity_research_result.schema.json",
  "title": "EquityResearchResult",
  "description": "个股研报结果（Phase 4 任务书 3.9.3-20）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_id", "run_id", "request_id", "company_entity_id", "security_entity_id",
    "as_of", "research_status", "coverage", "key_finding_ids", "financial_metric_ids",
    "segment_ids", "peer_selection_id", "valuation_snapshot_id",
    "forecast_scenario_ids", "catalyst_ids", "risk_ids", "phase3_link_ids",
    "claim_ids", "evidence_ids", "unknowns", "conflicts", "warnings",
    "report_path", "validator_summary", "model_route_summary", "version", "created_at"
  ],
  "properties": {
    "result_id": { "type": "string" },
    "run_id": { "type": "string" },
    "request_id": { "type": "string" },
    "company_entity_id": { "type": "string", "pattern": "^company:" },
    "security_entity_id": { "type": "string", "pattern": "^security:" },
    "as_of": { "type": "string", "format": "date-time" },
    "research_status": { "type": "string", "enum": ["success", "partial_success", "degraded", "insufficient_data", "source_conflict", "validation_failed", "failed"] },
    "coverage": { "type": "object" },
    "key_finding_ids": { "type": "array", "items": { "type": "string" } },
    "financial_metric_ids": { "type": "array", "items": { "type": "string" } },
    "segment_ids": { "type": "array", "items": { "type": "string" } },
    "peer_selection_id": { "anyOf": [ { "type": "string" }, { "type": "null" } ] },
    "valuation_snapshot_id": { "anyOf": [ { "type": "string" }, { "type": "null" } ] },
    "forecast_scenario_ids": { "type": "array", "items": { "type": "string" } },
    "catalyst_ids": { "type": "array", "items": { "type": "string" } },
    "risk_ids": { "type": "array", "items": { "type": "string" } },
    "phase3_link_ids": { "type": "array", "items": { "type": "string" } },
    "claim_ids": { "type": "array", "items": { "type": "string" } },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "report_path": { "anyOf": [ { "type": "string" }, { "type": "null" } ] },
    "validator_summary": { "type": "object" },
    "model_route_summary": { "type": "object" },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
