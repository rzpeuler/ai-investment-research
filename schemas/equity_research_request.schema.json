{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-os.local/schemas/equity_research_request.schema.json",
  "title": "EquityResearchRequest",
  "description": "个股研报请求（Phase 4 任务书 3.9.3-18）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id", "task_id", "company_entity_id", "security_entity_id", "as_of", "as_of_basis",
    "report_date", "timezone", "depth", "periods", "peer_overrides",
    "scenario_ids", "include_valuation", "include_forecast", "live", "dry_run",
    "force", "input_document_ids", "financial_manifest_ids", "market_manifest_ids",
    "source_policy", "status", "warnings", "rule_versions", "requested_at", "version"
  ],
  "properties": {
    "request_id": { "type": "string" },
    "task_id": { "type": "string" },
    "company_entity_id": { "type": "string", "pattern": "^company:" },
    "security_entity_id": { "type": "string", "pattern": "^security:" },
    "as_of": { "type": "string", "format": "date-time" },
    "as_of_basis": { "type": "string", "enum": ["user_provided", "query_cutoff", "data_derived", "unknown"] },
    "report_date": { "type": "string", "format": "date" },
    "timezone": { "type": "string", "const": "Asia/Shanghai" },
    "depth": { "type": "string", "enum": ["fast", "standard", "deep"] },
    "periods": { "type": "integer", "minimum": 2, "maximum": 10 },
    "peer_overrides": { "type": "array", "items": { "type": "string" } },
    "scenario_ids": { "type": "array", "items": { "type": "string" } },
    "include_valuation": { "type": "boolean" },
    "include_forecast": { "type": "boolean" },
    "live": { "type": "boolean" },
    "dry_run": { "type": "boolean" },
    "force": { "type": "boolean" },
    "input_document_ids": { "type": "array", "items": { "type": "string" } },
    "financial_manifest_ids": { "type": "array", "items": { "type": "string" } },
    "market_manifest_ids": { "type": "array", "items": { "type": "string" } },
    "source_policy": { "type": "string", "enum": ["public_first", "official_first", "manual_only"] },
    "status": { "type": "string", "enum": ["planned", "validated", "rejected"] },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "rule_versions": { "type": "object" },
    "requested_at": { "type": "string", "format": "date-time" },
    "version": { "type": "integer", "minimum": 1 }
  }
}
