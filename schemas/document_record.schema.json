{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-os.local/schemas/document_record.schema.json",
  "title": "DocumentRecord",
  "description": "文档文件和解析状态登记（Phase 4 任务书 3.9.3-3）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id", "company_entity_id", "security_entity_id", "document_type",
    "title", "source_id", "source_url", "local_path", "external_id",
    "published_at", "retrieved_at", "report_period_end", "fiscal_year",
    "language", "mime_type", "file_size_bytes", "sha256", "version_label",
    "supersedes_document_id", "storage_policy", "copyright_status",
    "text_layer_status", "table_parse_status", "ocr_status", "parser_name",
    "parser_version", "page_count", "audit_status", "parse_status",
    "warnings", "version", "created_at", "updated_at"
  ],
  "properties": {
    "document_id": { "type": "string" },
    "company_entity_id": { "anyOf": [ { "type": "string" }, { "type": "null" } ] },
    "security_entity_id": { "anyOf": [ { "type": "string" }, { "type": "null" } ] },
    "document_type": {
      "type": "string",
      "enum": ["annual_report", "interim_report", "quarterly_report", "announcement", "inquiry_letter", "inquiry_response", "prospectus", "ir_record", "audit_report", "other"]
    },
    "title": { "type": "string", "minLength": 1 },
    "source_id": { "type": "string", "minLength": 1 },
    "source_url": { "anyOf": [ { "type": "string" }, { "type": "null" } ] },
    "local_path": { "anyOf": [ { "type": "string" }, { "type": "null" } ] },
    "external_id": { "anyOf": [ { "type": "string" }, { "type": "null" } ] },
    "published_at": { "type": "string", "format": "date-time" },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "report_period_end": { "anyOf": [ { "type": "string", "format": "date" }, { "type": "null" } ] },
    "fiscal_year": { "anyOf": [ { "type": "integer" }, { "type": "null" } ] },
    "language": { "type": "string" },
    "mime_type": { "type": "string" },
    "file_size_bytes": { "anyOf": [ { "type": "integer", "minimum": 0 }, { "type": "null" } ] },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "version_label": { "anyOf": [ { "type": "string" }, { "type": "null" } ] },
    "supersedes_document_id": { "anyOf": [ { "type": "string" }, { "type": "null" } ] },
    "storage_policy": { "type": "string", "enum": ["metadata_only", "metadata_and_excerpt", "local_file_reference"] },
    "copyright_status": { "type": "string", "enum": ["statutory_filing", "user_provided", "licensed", "unknown"] },
    "text_layer_status": { "type": "string", "enum": ["present", "absent", "partial", "unknown"] },
    "table_parse_status": { "type": "string", "enum": ["not_started", "success", "partial", "failed"] },
    "ocr_status": { "type": "string", "enum": ["not_needed", "not_available", "not_started", "success", "partial", "failed"] },
    "parser_name": { "anyOf": [ { "type": "string" }, { "type": "null" } ] },
    "parser_version": { "anyOf": [ { "type": "string" }, { "type": "null" } ] },
    "page_count": { "anyOf": [ { "type": "integer", "minimum": 0 }, { "type": "null" } ] },
    "audit_status": { "type": "string", "enum": ["audited", "reviewed", "unaudited", "not_applicable", "unknown"] },
    "parse_status": { "type": "string", "enum": ["registered", "parsed", "partial", "failed", "corrected"] },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
