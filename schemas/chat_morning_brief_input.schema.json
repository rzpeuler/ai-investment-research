{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-os.local/schemas/chat_morning_brief_input.schema.json",
  "title": "ChatMorningBriefInput",
  "description": "晨报会话中由用户表达的语义。",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity_mentions", "industry_mentions", "report_date_expression", "research_focus", "complete", "clarification_question"],
  "properties": {
    "entity_mentions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "industry_mentions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "report_date_expression": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "research_focus": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "complete": {"type": "boolean"},
    "clarification_question": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
  }
}
