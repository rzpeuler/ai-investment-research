{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-os.local/schemas/industry_research_request.schema.json",
  "title": "IndustryResearchRequest",
  "description": "行业研究请求（Phase 6A）",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "task_id", "industry_id", "as_of", "as_of_basis", "timezone", "depth", "live", "dry_run", "force", "source_policy", "status", "warnings", "rule_versions", "version"],
  "properties": {
    "request_id": {"type": "string"},
    "task_id": {"type": "string"},
    "industry_id": {"type": "string"},
    "industry_name": {"type": "string"},
    "as_of": {"type": "string"},
    "as_of_basis": {"type": "string"},
    "timezone": {"type": "string"},
    "depth": {"type": "string", "enum": ["fast", "standard", "deep"]},
    "deterministic_only": {"type": "boolean"},
    "live": {"type": "boolean"},
    "dry_run": {"type": "boolean"},
    "force": {"type": "boolean"},
    "source_policy": {"type": "string"},
    "status": {"type": "string"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "rule_versions": {"type": "object"},
    "requested_at": {"type": "string"},
    "version": {"type": "integer", "minimum": 1}
  }
}
