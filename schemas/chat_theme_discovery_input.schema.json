{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-os.local/schemas/chat_theme_discovery_input.schema.json",
  "title": "ChatThemeDiscoveryInput",
  "description": "主题发现会话中由用户表达的语义，不表达选股或交易建议。",
  "type": "object",
  "additionalProperties": false,
  "required": ["theme_keywords", "industry_mentions", "temporal_expression", "research_question", "research_focus", "depth_hint", "complete", "clarification_question"],
  "properties": {
    "theme_keywords": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "industry_mentions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "temporal_expression": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "research_question": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "research_focus": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "depth_hint": {"enum": [null, "fast", "standard", "deep"]},
    "complete": {"type": "boolean"},
    "clarification_question": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
  }
}
