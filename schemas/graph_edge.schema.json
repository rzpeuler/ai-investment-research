{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-os.local/schemas/graph_edge.schema.json",
  "title": "GraphEdge",
  "description": "产业图谱关系。既是 GraphChange candidate payload 也是 apply 后的正式 core graph object。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "edge_id", "source_node_id", "relation", "target_node_id", "attributes",
    "assertion_type", "valid_from", "valid_to", "confidence", "evidence_ids",
    "review_status", "version", "originating_graph_change_id", "created_at", "last_reviewed_at"
  ],
  "properties": {
    "edge_id": { "type": "string", "minLength": 1 },
    "source_node_id": { "type": "string", "minLength": 1 },
    "relation": {
      "type": "string",
      "enum": ["BELONGS_TO","UPSTREAM_OF","DOWNSTREAM_OF","SUPPLIES","PURCHASES_FROM","PRODUCES","USES_TECHNOLOGY","APPLIED_IN","COMPETES_WITH","SUBSTITUTES","BENEFITS_FROM","HARMED_BY","AFFECTS","MENTIONED_IN","SUPPORTED_BY","CONTRADICTED_BY","HAS_METRIC","HAS_CATALYST"]
    },
    "target_node_id": { "type": "string", "minLength": 1 },
    "attributes": { "type": "object" },
    "assertion_type": { "type": "string", "enum": ["GOVERNANCE","FACT","MODEL_INFERENCE"] },
    "valid_from": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
    "valid_to": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "review_status": { "type": "string", "enum": ["candidate","approved"] },
    "version": { "type": "integer", "minimum": 1 },
    "originating_graph_change_id": { "anyOf": [{ "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" }, { "type": "null" }] },
    "created_at": { "type": "string", "format": "date-time" },
    "last_reviewed_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "assertion_type": { "enum": ["FACT","MODEL_INFERENCE"] } },
        "required": ["assertion_type"]
      },
      "then": {
        "properties": {
          "evidence_ids": { "minItems": 1 },
          "originating_graph_change_id": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" }
        }
      }
    },
    {
      "if": {
        "properties": { "assertion_type": { "const": "GOVERNANCE" } },
        "required": ["assertion_type"]
      },
      "then": {
        "properties": {
          "evidence_ids": { "maxItems": 0 },
          "originating_graph_change_id": { "type": "null" },
          "review_status": { "const": "approved" }
        }
      }
    }
  ]
}
