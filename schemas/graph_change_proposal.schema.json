{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-os.local/schemas/graph_change_proposal.schema.json",
  "title": "GraphChangeProposal",
  "description": "LLM 生成的图谱变更提案。Proposal 不允许包含持久化 UUID / version / review_status / reviewed_at / database primary key / active status。之后由确定性代码 validate → qualify evidence → assign IDs → assign timestamps → compare current graph → construct GraphChange(candidate)。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_type",
    "source_object_ids",
    "candidate_node",
    "candidate_edge",
    "new_evidence_ids",
    "suggested_change",
    "impact_scope",
    "conflicts",
    "verification_points",
    "confidence"
  ],
  "properties": {
    "proposal_type": {
      "type": "string",
      "enum": ["add_node", "add_edge", "modify_attribute", "retire_edge", "retire_node"],
      "description": "提案类型。与 GraphChangeType 一致。"
    },
    "source_object_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" },
      "description": "来源结构化对象 ID（Event/Claim/ResearchFinding 等）"
    },
    "candidate_node": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["existing_node_id", "node_type", "name", "aliases", "description", "valid_from", "valid_to"],
          "properties": {
            "existing_node_id": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ],
              "description": "已有节点 ID。add_node 时为 null；modify_attribute / retire_node 时非 null。"
            },
            "node_type": {
              "type": "string",
              "enum": [
                "Industry", "IndustrySegment", "Company", "Product", "Technology",
                "Material", "Equipment", "Application", "Policy", "Event",
                "Metric", "PersonOrInstitution", "Report", "InvestmentTheme"
              ]
            },
            "name": { "type": "string", "minLength": 1 },
            "aliases": { "type": "array", "items": { "type": "string" } },
            "description": { "type": "string" },
            "valid_from": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
            "valid_to": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] }
          }
        },
        { "type": "null" }
      ],
      "description": "候选节点。add_node / retire_node 时非 null；add_edge / retire_edge 时须为 null。"
    },
    "candidate_edge": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_node_id", "relation", "target_node_id", "attributes", "assertion_type", "valid_from", "valid_to", "confidence"],
          "properties": {
            "source_node_id": { "type": "string", "minLength": 1 },
            "relation": {
              "type": "string",
              "enum": [
                "BELONGS_TO", "UPSTREAM_OF", "DOWNSTREAM_OF", "SUPPLIES",
                "PURCHASES_FROM", "PRODUCES", "USES_TECHNOLOGY", "APPLIED_IN",
                "COMPETES_WITH", "SUBSTITUTES", "BENEFITS_FROM", "HARMED_BY",
                "AFFECTS", "MENTIONED_IN", "SUPPORTED_BY", "CONTRADICTED_BY",
                "HAS_METRIC", "HAS_CATALYST"
              ]
            },
            "target_node_id": { "type": "string", "minLength": 1 },
            "attributes": { "type": "object" },
            "assertion_type": {
              "type": "string",
              "enum": ["FACT", "MODEL_INFERENCE"],
              "description": "运行时 proposal 禁止 GOVERNANCE。"
            },
            "valid_from": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
            "valid_to": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
            "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
          }
        },
        { "type": "null" }
      ],
      "description": "候选关系。add_edge / retire_edge 时非 null；add_node / retire_node 时须为 null。"
    },
    "new_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" },
      "description": "新证据 ID。运行时 proposal 不承担 governance seed。"
    },
    "suggested_change": { "type": "string", "minLength": 1, "description": "建议变更说明" },
    "impact_scope": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": "array", "items": { "type": "string" } },
    "verification_points": { "type": "array", "items": { "type": "string" } },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "提案置信度 0.0-1.0。不能替代 Evidence。"
    }
  }
}
