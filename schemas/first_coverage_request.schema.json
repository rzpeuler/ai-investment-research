{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-os.local/schemas/first_coverage_request.schema.json",
  "title": "FirstCoverageRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "task_id", "company_entity_id", "security_entity_id", "as_of", "as_of_basis", "timezone", "industry_id", "industry_name", "phase4_result_id", "phase4_selection_policy", "depth", "earnings_expectation", "live", "dry_run", "force", "source_policy", "status", "warnings", "rule_versions", "requested_at", "version"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "company_entity_id": {"type": "string", "pattern": "^company:"},
    "security_entity_id": {"type": "string", "pattern": "^security:"},
    "as_of": {"type": "string", "format": "date-time"},
    "as_of_basis": {"type": "string", "enum": ["user_provided"]},
    "timezone": {"type": "string", "enum": ["Asia/Shanghai"]},
    "industry_id": {"type": "string", "minLength": 1},
    "industry_name": {"type": "string"},
    "phase4_result_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "phase4_selection_policy": {"type": "string", "enum": ["latest_accepted_at_or_before_as_of"]},
    "depth": {"type": "string", "enum": ["fast", "standard", "deep"]},
    "earnings_expectation": {"anyOf": [{"$ref": "#/definitions/earningsInput"}, {"type": "null"}]},
    "live": {"type": "boolean"}, "dry_run": {"type": "boolean"}, "force": {"type": "boolean"},
    "source_policy": {"type": "string", "enum": ["authoritative_db_only"]},
    "status": {"type": "string", "enum": ["validated"]},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "rule_versions": {"type": "object"},
    "requested_at": {"type": "string", "format": "date-time"},
    "version": {"type": "integer", "minimum": 1}
  },
  "definitions": {
    "earningsInput": {
      "type": "object", "additionalProperties": false,
      "required": ["forecast_period", "assumptions", "metric_code", "scenario_name"],
      "properties": {
        "forecast_period": {"$ref": "earnings_expectation_request.schema.json#/definitions/forecastPeriod"},
        "assumptions": {"type": "array", "minItems": 1, "items": {"$ref": "earnings_expectation_request.schema.json#/definitions/assumption"}},
        "metric_code": {"type": "string", "minLength": 1},
        "scenario_name": {"type": "string", "minLength": 1}
      }
    }
  }
}
