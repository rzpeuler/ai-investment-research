{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-os.local/schemas/business_segment.schema.json",
  "title": "BusinessSegment",
  "description": "报告期内业务、产品或地区分部（Phase 4 任务书 3.9.3-9）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "segment_id", "company_entity_id", "financial_report_id", "parent_segment_id",
    "segment_type", "raw_name", "canonical_name", "mapping_method",
    "mapping_confidence", "valid_from", "valid_to", "revenue", "revenue_share",
    "profit", "profit_margin", "volume", "average_price", "currency",
    "unit_scale", "metric_fact_ids", "source_block_ids", "evidence_ids",
    "reclassification_group_id", "status", "version", "created_at"
  ],
  "properties": {
    "segment_id": { "type": "string" },
    "company_entity_id": { "type": "string", "pattern": "^company:" },
    "financial_report_id": { "type": "string" },
    "parent_segment_id": { "anyOf": [ { "type": "string" }, { "type": "null" } ] },
    "segment_type": { "type": "string", "enum": ["product", "geography", "customer", "channel", "other"] },
    "raw_name": { "type": "string", "minLength": 1 },
    "canonical_name": { "type": "string", "minLength": 1 },
    "mapping_method": { "type": "string", "enum": ["rule", "llm_assisted", "manual"] },
    "mapping_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "valid_from": { "type": "string", "format": "date" },
    "valid_to": { "anyOf": [ { "type": "string", "format": "date" }, { "type": "null" } ] },
    "revenue": { "anyOf": [ { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" }, { "type": "null" } ] },
    "revenue_share": { "anyOf": [ { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" }, { "type": "null" } ] },
    "profit": { "anyOf": [ { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" }, { "type": "null" } ] },
    "profit_margin": { "anyOf": [ { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" }, { "type": "null" } ] },
    "volume": { "anyOf": [ { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" }, { "type": "null" } ] },
    "average_price": { "anyOf": [ { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" }, { "type": "null" } ] },
    "currency": { "anyOf": [ { "type": "string", "pattern": "^[A-Z]{3}$" }, { "type": "null" } ] },
    "unit_scale": { "anyOf": [ { "type": "integer" }, { "type": "null" } ] },
    "metric_fact_ids": { "type": "array", "items": { "type": "string" } },
    "source_block_ids": { "type": "array", "items": { "type": "string" } },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "reclassification_group_id": { "anyOf": [ { "type": "string" }, { "type": "null" } ] },
    "status": { "type": "string", "enum": ["active", "superseded", "conflict"] },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
