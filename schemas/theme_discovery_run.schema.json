{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-os.local/schemas/theme_discovery_run.schema.json",
  "title": "ThemeDiscoveryRun",
  "description": "主题发现运行记录（Phase 6A）",
  "type": "object",
  "additionalProperties": true,
  "required": ["run_id", "request_id", "task_id", "idempotency_key", "run_version", "started_at", "finished_at", "status", "stage_statuses", "artifact_paths", "input_versions", "model_route_summary", "validation_status", "error_codes", "themes_discovered", "version"],
  "properties": {
    "run_id": {"type": "string"},
    "request_id": {"type": "string"},
    "task_id": {"type": "string"},
    "as_of": {"type": "string"},
    "discovery_mode": {"type": "string"},
    "status": {"type": "string", "enum": ["success", "partial_success", "degraded", "insufficient_evidence", "failed"]},
    "idempotency_key": {"type": "string"},
    "run_version": {"type": "integer", "minimum": 1},
    "started_at": {"type": "string"},
    "finished_at": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "stage_statuses": {"type": "array"},
    "artifact_paths": {"type": "array"},
    "input_versions": {"type": "object"},
    "model_route_summary": {"type": "object"},
    "validation_status": {"type": "string"},
    "error_codes": {"type": "array"},
    "warnings": {"type": "array"},
    "missing_data": {"type": "array"},
    "themes_discovered": {"type": "integer", "minimum": 0},
    "industry_ids": {"type": "array"},
    "keywords": {"type": "array"},
    "model_route": {"type": "object"},
    "version": {"type": "integer", "minimum": 1}
  }
}
