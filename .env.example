# AI＋A股投研 Skill 项目环境变量模板
# 复制为 .env 并填写真实值。.env 不得提交到 Git。

# --- 项目 ---
# 项目根目录（绝对路径）
RESEARCH_PROJECT_PATH=

# 时区（默认 Asia/Shanghai，勿改）
RESEARCH_TIMEZONE=Asia/Shanghai

# --- 模型路由（Phase 0 仅占位，Phase 1+ 使用）---
# 默认执行模型
RESEARCH_MODEL_FLASH=deepseek-v4-flash
# 复杂任务升级模型
RESEARCH_MODEL_PRO=deepseek-v4-pro
# Provider（Hermes 集成时使用）
RESEARCH_PROVIDER=deepseek

# --- 数据源凭据（Phase 1 探测后按需填写）---
# 任何平台 API Key 仅在通过来源注册表审批后配置
# XUEQIU_TOKEN=
# CLS_TOKEN=

# --- 存储 ---
# SQLite 数据库目录（默认 <project>/data/sqlite）
RESEARCH_SQLITE_DIR=
